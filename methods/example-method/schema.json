{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "example-method-output",
  "type": "object",
  "additionalProperties": false,
  "required": ["signal", "summary"],
  "properties": {
    "signal": {
      "type": "string",
      "enum": ["positive", "neutral", "negative", "insufficient"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}

